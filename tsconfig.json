{
    "compilerOptions": {
        "target": "ES2015",
        "module": "ESNext",
        "moduleResolution": "node",
        "declaration": true,
        "declarationDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "lib": ["ES2015", "DOM"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
